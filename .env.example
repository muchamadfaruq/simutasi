# ============================================================
#  SIMUTASI - contoh konfigurasi
#  Salin berkas ini menjadi ".env" lalu sesuaikan.
#    cp .env.example .env
# ============================================================

# ---------- Alamat publik & HTTPS (dipakai Caddy) ----------
# Domain sungguhan  -> HTTPS otomatis (Let's Encrypt). Contoh:
#     DOMAIN=mutasi.sman2mengwi.sch.id
# Tanpa domain / uji coba (HTTP saja):
DOMAIN=:8080

# Surel pendaftaran sertifikat HTTPS (boleh dikosongkan saat HTTP saja)
ACME_EMAIL=admin@sman2mengwi.sch.id

# Port pada server host yang diteruskan ke container
HTTP_PORT=80
HTTPS_PORT=443
ALT_PORT=8080

# ---------- Akun admin pertama ----------
# Hanya dipakai sekali, saat basis data masih kosong.
# Bila ADMIN_PASSWORD dikosongkan, sandi acak akan dicetak pada log container.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiSandiIni123
ADMIN_NAME=Administrator Sekolah

# ---------- Pengaturan aplikasi ----------
# Lama sesi login (jam)
SESSION_HOURS=12
# auto  = ikut protokol (aman di belakang Caddy HTTPS)
# always = paksa cookie Secure, never = paksa tanpa Secure
COOKIE_SECURE=auto
# Batas ukuran satu berkas lampiran (MB)
MAX_UPLOAD_MB=15
# Muat 7 data contoh saat basis data masih kosong (true/false)
SEED_SAMPLE_DATA=true
